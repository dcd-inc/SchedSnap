# Copy to .env.local for development, or add values in Vercel environment settings.
# Only VITE_ variables are public. Keep all other credentials server-only.
# Restart development or redeploy after changing values. Never commit real secrets.

# Google Gemini schedule import. Manual entry works without these credentials.
# Paste your keys on ONE line, separated by commas. One key also works.
# Example: GEMINI_API_KEYS=your_first_key,your_second_key,your_third_key
# On quota errors (429), tries the next key; blanks and duplicates are ignored.
# Keys in the same Google Cloud project share quota. Keep this server-only.
# Remove old GEMINI_API_KEY / GEMINI_FALLBACK_API_KEY entries from your local
# or Vercel settings if you want only this list used (old entries run first).
GEMINI_API_KEYS=
# Model ID used by the current extraction API; verify project access to this model.
GEMINI_MODEL=gemini-3.5-flash-lite

# DeepSeek fallback schedule import. Used when Gemini fails or returns invalid output.
# When enabled, Gemini gets up to 20 seconds, reserving 25 seconds for DeepSeek.
# Server-only. Leave blank to disable fallback. Runs non-thinking JSON mode (no billed reasoning tokens).
# `deepseek-v4-flash` is an accepted alias for the cheapest Flash model (same price).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Temporarily skip Gemini so schedule imports can be tested with DeepSeek alone.
DEEPSEEK_ONLY=false

# Daily AI import limit per IP, resetting at midnight Philippine time.
# Defaults to 15 when unset or invalid. Required in production: create an Upstash Redis
# database and copy its REST URL/token. Without storage configuration, production AI
# imports are blocked; manual entry works. Local development uses an in-memory counter.
IMPORT_DAILY_LIMIT=15
# Feedback submissions per IP per day (midnight Philippine time). Defaults to 10.
FEEDBACK_DAILY_LIMIT=10
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# A private random secret used to hash IP addresses before storing counters.
IMPORT_LIMIT_SECRET=

# Public design hearts reuse these Upstash credentials and IMPORT_LIMIT_SECRET.
# The secret also signs the anonymous voting cookie; keep it stable between deploys.
# Redis votes do not expire. Local development uses memory when unconfigured.

# Read the homepage pageview total from PostHog. Server-only, never use VITE_ here.
# Create a personal API key with query:read, restricted to project 643035.
# Missing query credentials display an unavailable count; Redis is not required.
POSTHOG_PROJECT_ID=643035
POSTHOG_PERSONAL_API_KEY=
# Private query host. For EU projects use https://eu.posthog.com.
POSTHOG_API_HOST=https://us.posthog.com

# Public PostHog project token, never a personal or secret API key.
# Get this public token from project 643035; events are tagged site_name: schedsnap.
VITE_POSTHOG_TOKEN=
# Public ingestion host. For EU projects use https://eu.i.posthog.com.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudinary artwork delivery, catalog management, and uploads. Server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin password (16-256 characters). Server-only.
ADMIN_PASSWORD=
# Optional explicit session-signing secret: at least 32 characters when set.
# Required when using ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Optional scrypt hash from npm run admin:setup; leave ADMIN_PASSWORD empty to use it.
ADMIN_PASSWORD_HASH=
# Set true after enabling the Vercel login rate limit.
ADMIN_LOGIN_RATE_LIMIT_CONFIGURED=false

# Optional PostHog shared dashboard embed link, returned only after admin login.
POSTHOG_DASHBOARD_EMBED_URL=
